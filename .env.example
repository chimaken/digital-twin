# OpenRouter (required for RAG, router, and research agents)
OPENROUTER_API_KEY=sk-or-v1-...

# Web search for research agent (optional; if unset, DuckDuckGo is used)
# BRAVE_API_KEY=...

# Backend CORS: set when frontend is on another domain (e.g. Vercel/Netlify)
# FRONTEND_ORIGIN=https://your-app.vercel.app

# Optional: override models (defaults: gpt-4o-mini for all)
# OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small
# OPENROUTER_ROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_RAG_MODEL=openai/gpt-4o-mini
# OPENROUTER_RESEARCH_MODEL=openai/gpt-4o-mini

# Optional: RAG confidence threshold (0..1). If top chunk score >= this, use CV without asking router LLM.
# RAG_SCORE_THRESHOLD=0.5
